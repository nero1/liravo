{
  "expo": {
    "name": "Liravo",
    "slug": "liravo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.liravo.app",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "fr",
          "de"
        ]
      }
    },
    "android": {
      "package": "org.liravo.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Liravo to access your photos to set a profile picture."
        }
      ],
      "react-native-iap",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "liravo",
    "locales": {
      "en": {
        "NSPhotoLibraryUsageDescription": "Allow Liravo to access your photos to set a profile picture."
      },
      "fr": {
        "NSPhotoLibraryUsageDescription": "Autorisez Liravo à accéder à vos photos pour choisir une photo de profil."
      },
      "de": {
        "NSPhotoLibraryUsageDescription": "Erlaube Liravo den Zugriff auf deine Fotos, um ein Profilbild auszuwählen."
      }
    }
  }
}
