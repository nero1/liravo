EXPO_PUBLIC_API_URL=https://liravo.org

# Set to "digitalocean" when using DigitalOcean + custom auth.
# Leave unset or set to "supabase" to use Supabase Google OAuth.
EXPO_PUBLIC_DATABASE_PROVIDER=supabase

# Required when DATABASE_PROVIDER=supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required when DATABASE_PROVIDER=digitalocean (for Google sign-in)
# Create an Android OAuth client in Google Cloud Console and paste the client ID here.
# Also register your Expo redirect URI: https://auth.expo.io/@your-expo-username/liravo
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-android-client-id.apps.googleusercontent.com
