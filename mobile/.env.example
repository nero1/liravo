EXPO_PUBLIC_API_URL=https://liravo.org

# Set to "digitalocean" when using DigitalOcean + custom auth (email/password).
# Leave unset or set to "supabase" to use Supabase Google OAuth.
EXPO_PUBLIC_DATABASE_PROVIDER=supabase

# Only required when DATABASE_PROVIDER=supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for Google Pay / Stripe
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
