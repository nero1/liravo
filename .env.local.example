# ── Database Provider ─────────────────────────────────────────────────────────
# Choose one: supabase (default) | digitalocean | railway
# DATABASE_PROVIDER=supabase
# NEXT_PUBLIC_DATABASE_PROVIDER=supabase

# ── Supabase ──────────────────────────────────────────────────────────────────
# Required when DATABASE_PROVIDER=supabase (or unset)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── DigitalOcean PostgreSQL ───────────────────────────────────────────────────
# Required when DATABASE_PROVIDER=digitalocean
# Use the PgBouncer URL (port 25061), NOT the direct connection (port 25432)
# DATABASE_PROVIDER=digitalocean
# NEXT_PUBLIC_DATABASE_PROVIDER=digitalocean
# DATABASE_URL=postgresql://user:pass@host:25061/dbname?sslmode=require
# DATABASE_POOL_MAX=5
# DATABASE_SSL=true

# ── Railway PostgreSQL (PgBouncer + PostgreSQL template) ──────────────────────
# Required when DATABASE_PROVIDER=railway
# Deploy via the "PgBouncer + PostgreSQL + pgAdmin" template on Railway.
# Set DATABASE_URL to the PgBouncer service URL (transaction pooling mode).
# Use DATABASE_DIRECT_URL (direct Postgres) only for running migrations.
# DATABASE_PROVIDER=railway
# NEXT_PUBLIC_DATABASE_PROVIDER=railway
# DATABASE_URL=postgresql://postgres:pass@pgbouncer.railway.internal:5432/railway
# DATABASE_DIRECT_URL=postgresql://postgres:pass@postgres.railway.internal:5432/railway
# DATABASE_POOL_MAX=5
# DATABASE_SSL=true

# Redis (choose one provider)
# REDIS_PROVIDER=ioredis
# REDIS_URL=redis://localhost:6379
REDIS_PROVIDER=upstash
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI
AI_PRIMARY_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
GEMINI_API_KEY=your-gemini-api-key

# Google Books
GOOGLE_BOOKS_API_KEY=your-google-books-key

# Auth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Payments
PAYSTACK_SECRET_KEY=your-paystack-secret
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
DODOPAYMENTS_API_KEY=your-dodopayments-api-key
DODOPAYMENTS_ENVIRONMENT=test_mode
DODOPAYMENTS_PREMIUM_PRODUCT_ID=
DODOPAYMENTS_WEBHOOK_SECRET=your-webhook-secret

# Google Play Billing (mobile app — subscriptions)
# Package name of the Android app
GOOGLE_PLAY_PACKAGE_NAME=org.liravo.app
# Service account JSON key (from Google Cloud Console → IAM → Service accounts)
# Grant this account "Financial data viewer" in Play Console → Setup → API access
# Paste the entire JSON as a single-line string
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"play-billing@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
# Random secret appended to the RTDN webhook URL as ?secret=xxx
GOOGLE_PLAY_RTDN_SECRET=your-long-random-rtdn-secret

# Cron
CRON_SECRET=your-long-random-cron-secret

# Email (Resend)
RESEND_API_KEY=your-resend-api-key

# Amazon Associates
AMAZON_ASSOCIATE_TAG_US=liravo-20
AMAZON_ASSOCIATE_TAG_UK=liravo-uk-21
AMAZON_ASSOCIATE_TAG_CA=liravo-ca-21
AMAZON_ASSOCIATE_TAG_AU=liravo-au-22
