{
  "crons": [
    { "path": "/api/cron/outbox-drain",            "schedule": "0 0 * * *"   },
    { "path": "/api/cron/leaderboard-snapshot",    "schedule": "0 2 * * *"   },
    { "path": "/api/cron/shelf-recommendations",   "schedule": "0 3 * * *"   },
    { "path": "/api/cron/similar-books",           "schedule": "0 4 * * *"   },
    { "path": "/api/cron/generate-prompts",        "schedule": "0 6 * * *"   },
    { "path": "/api/cron/ai-writing-plans",        "schedule": "0 7 * * *"   },
    { "path": "/api/cron/new-release-alerts",      "schedule": "0 8 * * *"   },
    { "path": "/api/cron/reading-goal-milestones", "schedule": "0 9 * * *"   },
    { "path": "/api/cron/account-hardening",       "schedule": "0 10 * * *"  },
    { "path": "/api/cron/taste-profiles",          "schedule": "0 1 * * 0"   },
    { "path": "/api/cron/email-digest",            "schedule": "0 11 * * *"   }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY"    },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
